{
  "description": "Declarative hook engine: runs the nudge rules for UserPromptSubmit, PreToolUse (plan-mode entry and Bash commands), and SubagentStart",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" UserPromptSubmit || python \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" PreToolUse || python \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" PreToolUse"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" SubagentStart || python \"${CLAUDE_PLUGIN_ROOT}/scripts/engine.py\" SubagentStart"
          }
        ]
      }
    ]
  }
}
